# ============================================================
# Variables de PRODUCCIÓN — copiá este archivo a .env en la VPS
# y cambiá TODOS los valores por secretos reales.
#   cp .env.production.example .env
#   nano .env   (editá los valores)
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambia-esta-root-password
MYSQL_PASSWORD=cambia-esta-password

# --- API JWT (secretos de firma de tokens) ---
# Generá con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambia-por-32-bytes-hex
JWT_REFRESH_SECRET=cambia-por-32-bytes-hex-diferente
API_KEY=cambia-esta-api-key-para-n8n

# --- Base de datos ---
# true = TypeORM sincroniza el schema automáticamente (conveniente en dev,
# pero en producción considerá false + migraciones)
DB_SYNCHRONIZE=true

# --- Dominios (dejá vacío si usás solo IP) ---
# DOMAIN_MAIN=misalon.com
# DOMAIN_ADMIN=admin.misalon.com
# DOMAIN_N8N=n8n.misalon.com
# DOMAIN_PMA=pma.misalon.com
