# ============================================================
# Superadmin — producción (multi-stage)
# Stage 1: build — compila el workspace y genera el bundle Vite
# Stage 2: runtime — sirve estáticos con nginx en el puerto 81
#           (el reverse proxy externo distingue dashboard:80 vs superadmin:81)
# ============================================================

# ---- Stage 1: build ----
FROM node:22-alpine AS build
WORKDIR /app

# Copiar manifests del workspace
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/pos-dashboard/package.json apps/pos-dashboard/package.json
COPY apps/superadmin/package.json apps/superadmin/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/validation/package.json packages/validation/package.json

RUN npm install

# Copiar código fuente
COPY apps/superadmin apps/superadmin
COPY packages packages

# Compilar packages que el frontend importa
RUN cd packages/types && (npx tsc -b 2>/dev/null || npx tsc) && cd /app
RUN cd packages/ui && (npx tsc -b 2>/dev/null || npx tsc) && cd /app

# Build Vite del superadmin
WORKDIR /app/apps/superadmin
RUN npm run build

# ---- Stage 2: runtime (nginx, puerto 81) ----
FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/superadmin/dist /usr/share/nginx/html
COPY docker/nginx/superadmin.conf /etc/nginx/conf.d/default.conf
EXPOSE 81
CMD ["nginx", "-g", "daemon off;"]
