# ============================================================
# Caddyfile — reverse proxy con HTTPS automático (Let's Encrypt)
# Dominio: uniongloss.com
#
# Requisito: los registros DNS deben apuntar a 51.161.113.43
#   uniongloss.com      → A 51.161.113.43
#   admin.uniongloss.com → A 51.161.113.43
#   n8n.uniongloss.com   → A 51.161.113.43
#   pma.uniongloss.com   → A 51.161.113.43
#
# Caddy genera los certificados HTTPS SOLO automáticamente.
# ============================================================

uniongloss.com {
    reverse_proxy dashboard:80
}

www.uniongloss.com {
    redir https://uniongloss.com{uri} permanent
}

admin.uniongloss.com {
    reverse_proxy superadmin:81
}

n8n.uniongloss.com {
    reverse_proxy n8n:5678
}

pma.uniongloss.com {
    reverse_proxy phpmyadmin:80
}
