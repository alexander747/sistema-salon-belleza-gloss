# ============================================================
# Caddyfile — reverse proxy con HTTPS automático
# SOLO SE USA CUANDO TENGAS DOMINIO (modo prueba usa puertos directos)
#
# 1. Apuntá tu dominio (ej. misalon.com) y subdominios a 51.161.113.43
# 2. Reemplazá misalon.com por tu dominio real
# 3. Descomentá el servicio caddy en docker-compose.prod.yml
# 4. Caddy genera el certificado Let's Encrypt SOLO (gratis)
# ============================================================

misalon.com {
    reverse_proxy dashboard:80
}

admin.misalon.com {
    reverse_proxy superadmin:81
}

n8n.misalon.com {
    reverse_proxy n8n:5678
}

pma.misalon.com {
    reverse_proxy phpmyadmin:80
}
